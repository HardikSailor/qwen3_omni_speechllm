#!/bin/bash
#PBS -N omni_2x8
#PBS -l select=2:ngpus=8:ncpus=112:mem=1880GB
# (no place=: the R212478 reservation is place=free; whole-node chunks land on separate nodes anyway)
#PBS -l walltime=04:00:00
#PBS -q R212478
#PBS -P 13003558_R4
#PBS -j oe
#PBS -o /scratch/users/astar/ares/sailorhb/git_repos/qwen3_omni_speechllm/outputs/pbs_logs/train_16gpu_2node.log
#
# Multi-node check: both trainers on 2 nodes x 8 GPUs = 16 GPUs, mixes/st_v0.yaml, global batch 32 (micro-batch 1 x grad-accum 2
# x 16 ranks), padding-free. Same recipe as train_8gpu_both.pbs, so loss curves should be close to the 8-GPU run.
#   N0   NCCL all_reduce check (bandwidth; a few GB/s = InfiniBand not used -> stop and fix before training)
#   H16A HF DDP (swift sft) 60 steps, eval + checkpoint at 30/60     H16B  resume H16A step 30 -> 60
#   M16A Megatron EP=8 (experts inside a node, DP=16) 60 iterations  M16B  resume M16A iteration 30 with optimizer
# Submit: qsub [-v MIX_FILE=mixes/<mix>.yaml] pbs/train_16gpu_2node.pbs      Summary: outputs/train_16gpu/summary.txt
# Dry run of the launcher logic (no GPUs, no scheduler): DRY_RUN=1 PBS_NODEFILE=<file> bash pbs/train_16gpu_2node.pbs
# Launch: pbsdsh starts nscc/node_run.sh on every node; it derives NNODES / NODE_RANK / MASTER_ADDR from the node list.
set -u
source /scratch/users/astar/ares/sailorhb/git_repos/qwen3_omni_speechllm/nscc/env.sh   # P, C, MODEL, MIX, RUN, ...
O=$P/outputs/train_16gpu${MIX_FILE:+_$(basename $MIX_FILE .yaml)}   # MIX_FILE (qsub -v MIX_FILE=mixes/x.yaml) replaces the configs' mix
mkdir -p $O; cd $P
NODES=$O/nodes.txt
awk '{sub(/\..*/,"")} !s[$0]++' "${PBS_NODEFILE:?not inside a PBS job}" > $NODES
echo "job ${PBS_JOBID:-none} start $(date)"; echo "nodes: $(tr '\n' ' ' < $NODES)"
GPUS=8
LAUNCH=(pbsdsh --)
[ "${DRY_RUN:-0}" = 1 ] && LAUNCH=(bash -c 'for n in $(cat '$NODES'); do NODE_RUN_HOST=$n "$@"; done' _)   # dry run: emulate the nodes one after another here

# run_phase <name> <port> <shell command using $RUN and the trainer args>   -> $O/<name>.log (+ .node<K>.log)
run_phase () {
  local name=$1 port=$2 cmd=$3
  echo "=== $name $(date)"
  printf '%s\n' "$cmd" > $O/$name.cmd.sh   # pbsdsh re-parses its arguments in a shell on each node ($RUN expanded empty), so pass a file
  "${LAUNCH[@]}" env DRY_RUN=${DRY_RUN:-0} bash $P/nscc/node_run.sh $NODES $O/$name $port $GPUS -- bash $O/$name.cmd.sh
  local rc=$?; echo "$name exit=$rc"
}

# --- pre-flight: NCCL bandwidth across the 2 nodes
run_phase N0 29600 '$RUN python -m torch.distributed.run --nnodes $NNODES --node_rank $NODE_RANK --nproc_per_node $NPROC_PER_NODE --master_addr $MASTER_ADDR --master_port $MASTER_PORT '$P'/nscc/nccl_check.py'
grep -h nccl_check $O/N0.log 2>/dev/null

# Training settings: the recipe in configs/ (--config); only this script's differences are listed. Later flags replace earlier ones.
HF=(--config $P/configs/lora_ddp.yaml --gradient_accumulation_steps 2)   # 1 x 2 x 16 GPUs = global 32
MEG=(--config $P/configs/lora_megatron.yaml)
# W&B: qsub -v WANDB=1 ...; one run per phase (named after its output dir), all phases of this job in one group
[ "${WANDB:-0}" = 1 ] && { WB=(--wandb true --wandb_group ${PBS_JOBNAME:-omni}_${PBS_JOBID%%.*}); HF+=("${WB[@]}"); MEG+=("${WB[@]}"); }
[ -n "${MIX_FILE:-}" ] && { HF+=(--mix $MIX_FILE); MEG+=(--mix $MIX_FILE); echo "mix: $MIX_FILE"; }
q () { printf '%q ' "$@"; }              # shell-quote an argument array for bash -c

run_phase H16A 29601 "OMNI_LOG_SAMPLE_IDS=$O/ids_H16A \$RUN python train_omni.py sft $(q "${HF[@]}") --output_dir $O/H16A"
CK=$(ls -d $O/H16A/v*/checkpoint-30 2>/dev/null | head -1); echo "H16A checkpoint-30: $CK $(cat $CK/omni_mosaic_state.json 2>/dev/null)"
[ -n "$CK" ] && run_phase H16B 29602 "\$RUN python train_omni.py sft $(q "${HF[@]}") --resume_from_checkpoint $CK --output_dir $O/H16B"

run_phase M16A 29603 "OMNI_LOG_SAMPLE_IDS=$O/ids_M16A \$RUN python train_omni.py megatron $(q "${MEG[@]}") --finetune true --output_dir $O/M16A"
CK=$(ls -d $O/M16A/v*/checkpoint-30 2>/dev/null | head -1); echo "M16A checkpoint-30: $CK $(cat $CK/omni_mosaic_state.json 2>/dev/null)"
[ -n "$CK" ] && run_phase M16B 29604 "\$RUN python train_omni.py megatron $(q "${MEG[@]}") --mcore_adapter $CK --finetune false --no_load_optim false --no_load_rng false --output_dir $O/M16B"

echo "end $(date)"
[ "${DRY_RUN:-0}" = 1 ] && exit 0
{
  echo "## NCCL"; grep -h nccl_check $O/N0.log
  echo; echo "## HF DDP (swift sft), 16 GPUs";  $RUN python tests/summarize_smoke.py $O H16A H16B H16A
  echo; echo "partitions H16A:";  $RUN python tests/check_partitions.py $O/ids_H16A
  echo; echo "## Megatron EP=8, 16 GPUs";  $RUN python tests/summarize_smoke.py $O M16A M16B M16A
  echo; echo "partitions M16A:";  $RUN python tests/check_partitions.py $O/ids_M16A
} 2>&1 | grep -v "pynvml\|FutureWarning" > $O/summary.txt
cat $O/summary.txt
