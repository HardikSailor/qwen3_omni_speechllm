#!/bin/bash
#PBS -N omni_4gpu
#PBS -l select=1:ngpus=4:ncpus=56:mem=940GB
#PBS -l walltime=03:00:00
#PBS -q R212478
#PBS -P 13003558_R4
#PBS -j oe
#PBS -o /scratch/users/astar/ares/sailorhb/git_repos/qwen3_omni_speechllm/outputs/pbs_logs/train_4gpu_both.log
#
# Phase 4 + 7 (PIPELINE_PLAN.md §6): both trainers on 1 node x 4 H200 (4-GPU check of train_8gpu_both.pbs), mixes/st_v0.yaml, global batch 32, padding-free.
#   H4A  train_omni.py sft (HF DDP): LoRA r16 on thinker attention + audio proj1/proj2 (194 modules), micro-batch 1 x
#        4 GPUs x grad-accum 8, 60 steps, eval + checkpoint at 30/60
#   H4B  resume H4A step 30 -> 60: losses 31..60 must match H4A (data position = 30 x 32 = 960 samples)
#   M4A  train_omni.py megatron EP=4: LoRA r16 on attention (linear_qkv, linear_proj), micro-batch 1, global 32,
#        60 iterations, eval + resumable checkpoint at 30/60
#   M4B  resume M4A iteration 30 with optimizer (--no_save_optim false, see §10.4) -> 60
# H4A and M4A log the sample ids each rank reads (OMNI_LOG_SAMPLE_IDS) -> tests/check_partitions.py
# Summary: outputs/train_4gpu/summary.txt
set -u
source /scratch/users/astar/ares/sailorhb/git_repos/qwen3_omni_speechllm/nscc/env.sh   # sets P, C, MODEL, MIX, RUN, PYTHONPATH, data + container paths
O=$P/outputs/train_4gpu
export OMNI_MDS_CACHE=/tmp/$USER/omni_mds_cache
export NPROC_PER_NODE=4 CUDA_VISIBLE_DEVICES=0,1,2,3
mkdir -p $O; cd $P
echo "node $(hostname)  start $(date)"; nvidia-smi -L; df -h /tmp | tail -1

# Training settings: the recipe in configs/ (--config); only this script's differences are listed. Later flags replace earlier ones.
HF=(--config $P/configs/lora_ddp.yaml --gradient_accumulation_steps 8)   # 1 x 8 x 4 GPUs = global 32
MEG=(--config $P/configs/lora_megatron.yaml --expert_model_parallel_size 4)
# W&B: qsub -v WANDB=1 ...; one run per phase (named after its output dir), all phases of this job in one group
[ "${WANDB:-0}" = 1 ] && { WB=(--wandb true --wandb_group ${PBS_JOBNAME:-omni}_${PBS_JOBID%%.*}); HF+=("${WB[@]}"); MEG+=("${WB[@]}"); }

echo "=== H4A $(date)"
OMNI_LOG_SAMPLE_IDS=$O/ids_H4A MASTER_PORT=29581 $RUN python train_omni.py sft "${HF[@]}" --output_dir $O/H4A \
    > $O/H4A.log 2>&1; echo "H4A exit=$?"
CK=$(ls -d $O/H4A/v*/checkpoint-30 2>/dev/null | head -1); echo "H4A checkpoint-30: $CK $(cat $CK/omni_mosaic_state.json 2>/dev/null)"
echo "=== H4B (resume) $(date)"
[ -n "$CK" ] && { MASTER_PORT=29582 $RUN python train_omni.py sft "${HF[@]}" --resume_from_checkpoint $CK \
    --output_dir $O/H4B > $O/H4B.log 2>&1; echo "H4B exit=$?"; }

echo "=== M4A $(date)"
OMNI_LOG_SAMPLE_IDS=$O/ids_M4A MASTER_PORT=29583 $RUN python train_omni.py megatron "${MEG[@]}" --finetune true \
    --output_dir $O/M4A > $O/M4A.log 2>&1; echo "M4A exit=$?"
CK=$(ls -d $O/M4A/v*/checkpoint-30 2>/dev/null | head -1); echo "M4A checkpoint-30: $CK $(cat $CK/omni_mosaic_state.json 2>/dev/null)"
grep -h "eval_iters\|train_iters" $O/M4A.log | grep -i setting | head -3
echo "=== M4B (resume with optimizer) $(date)"
[ -n "$CK" ] && { MASTER_PORT=29584 $RUN python train_omni.py megatron "${MEG[@]}" --mcore_adapter $CK --finetune false \
    --no_load_optim false --no_load_rng false --output_dir $O/M4B > $O/M4B.log 2>&1; echo "M4B exit=$?"; }

echo "end $(date)"
{
  echo "## HF DDP (swift sft)";  $RUN python tests/summarize_smoke.py $O H4A H4B H4A
  echo; echo "partitions H4A:";  $RUN python tests/check_partitions.py $O/ids_H4A
  echo; echo "## Megatron EP=4";  $RUN python tests/summarize_smoke.py $O M4A M4B M4A
  echo; echo "partitions M4A:";  $RUN python tests/check_partitions.py $O/ids_M4A
} 2>&1 | grep -v "pynvml\|FutureWarning" > $O/summary.txt
cat $O/summary.txt
du -sh $O
